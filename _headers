# ------------------------------
# V5 Medical LTD - Cloudflare Pages 响应头配置
# 适配：Docsify 渲染、Stripe 支付、静态资源缓存、安全防护
# Last updated: 2026-09-23 (round 2: 过时安全头、.md 跨域、图片缓存)
# 2026-09-23 安全审计（P2-3）：
#   unsafe-eval 暂保留——站点 11 页使用 Tailwind Play CDN（cdn.tailwindcss.com）
#   运行时需 eval 编译 tailwind.config；移除前置条件：替换为构建后本地 CSS。
#   unsafe-inline 暂保留——全站 180 个内联 script 块，迁移计划见 docs/csp-migration-plan.md。
#   表单提交已外置 js/lead-forms.js（addEventListener），security-utils.js 已增强清洗。
# 2026-09-13 变更：CSP img-src 补充 raw.githubusercontent.com（config.js 图片回退源）、
#   www.gstatic.com / translate.googleapis.com（Google 翻译界面图片）；
#   新增 /*.webp 与 /*.avif 一年 immutable 缓存规则。
# ------------------------------

# ==============================
# 1. 全局安全响应头（全站生效）
# ==============================
/*
  # 防点击劫持：禁止任何页面嵌入本网站到 iframe
  X-Frame-Options: DENY
  # 防 MIME 类型嗅探：强制浏览器按声明的 Content-Type 解析资源
  X-Content-Type-Options: nosniff
  # [2026-09-23] 旧版 XSS Auditor 已被所有浏览器移除，1; mode=block 反而可能引入信息泄露；按 OWASP 建议显式关闭，由 CSP 负责
  X-XSS-Protection: 0
  # 来源策略：跨域时仅发送域名，保护隐私
  Referrer-Policy: strict-origin-when-cross-origin
  # 权限策略：仅开放 payment 权限（适配 Stripe 支付），其余敏感权限禁用
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self "https://js.stripe.com"), usb=(), accelerometer=(), gyroscope=()
  # HSTS：强制 HTTPS 访问（有效期1年），包含子域名并加入预加载列表
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # 跨域策略：禁止未授权跨域访问资源
  X-Permitted-Cross-Domain-Policies: none
  # 下载保护：禁止 IE 自动打开下载文件
  X-Download-Options: noopen
  # [2026-09-23] Expect-CT 已被浏览器废弃（CT 现为默认强制），移除
  # 品牌标识（自定义头，非标准但可用于标识站点）
  X-Company-Name: V5 Medical LTD
  X-Platform: Global Supply Chain

  # 内容安全策略（CSP）：精细化控制资源加载，适配业务所需
  # [FIX] 单行书写 —— Cloudflare Pages 不支持多行 header 值，原多行 CSP 实际未生效。
  # [FIX] 补充 googletagmanager / google-analytics / translate 域名：
  #       原 CSP 缺少 googletagmanager.com，导致博客的 GA4 被 CSP 拦截，统计一直失效。
  # [FIX 2026-09-13] img-src 补充 raw.githubusercontent.com（config.js 图片 FALLBACK_BASE）、
  #       www.gstatic.com / translate.googleapis.com（Google 翻译按钮与界面图片）。
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://www.google.com https://www.gstatic.com https://www.googletagmanager.com https://unpkg.com https://js.stripe.com https://translate.google.com https://translate.googleapis.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://fonts.googleapis.com https://translate.googleapis.com; img-src 'self' data: https://*.stripe.com https://pub-224e4e74685e409e833e89d4ab5143fb.r2.dev https://images.unsplash.com https://www.google-analytics.com https://www.googletagmanager.com https://raw.githubusercontent.com https://www.gstatic.com https://translate.googleapis.com; font-src 'self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com; connect-src 'self' https://api.whatsapp.com https://www.google-analytics.com https://analytics.google.com https://*.google-analytics.com https://raw.githubusercontent.com https://api.stripe.com https://translate.google.com https://translate.googleapis.com https://translate-pa.googleapis.com; frame-src 'self' https://www.google.com https://www.youtube.com https://*.stripe.com https://js.stripe.com https://translate.google.com https://translate.googleapis.com; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;

# ==============================
# 2. Docsify 适配：Markdown 文件解析
# ==============================
# 根目录 .md 文件
/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# blog 子目录 .md 文件
/blog/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# ==============================
# 3. 缓存策略：按资源类型精细化配置
# ==============================
# HTML 文件：立即重新验证，确保内容实时更新（适配产品目录/博客等动态内容）
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# 静态资源缓存
# CSS/JS/字体：1 年 immutable —— 页面引用必须带 ?v=ASSET_VERSION（build-static.py 自动同步）
# 图片：[2026-09-23] 改为 7 天 + 后台刷新。图片没有版本号，同路径替换图片时 immutable 会让老访客一年看到旧图
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.jpeg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.gif
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.ico
  Cache-Control: public, max-age=31536000, immutable
# [ADD 2026-09-13] 现代图片格式同样享受一年长期缓存
/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.avif
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# PDF 文件（产品手册/宣传册）：30天缓存，强制浏览器内联打开（不自动下载）
/*.pdf
  Content-Type: application/pdf
  Content-Disposition: inline
  Cache-Control: public, max-age=2592000
